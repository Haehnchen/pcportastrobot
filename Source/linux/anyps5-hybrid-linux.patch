diff --git a/core/libs/tests/GuestHostWriteHooks.cpp b/core/libs/tests/GuestHostWriteHooks.cpp
new file mode 100644
index 0000000000..83d90b9164
--- /dev/null
+++ b/core/libs/tests/GuestHostWriteHooks.cpp
@@ -0,0 +1,87 @@
+#include "prx/libkernel/include/Api.hpp"
+#include "prx/libkernel/File/include/File.hpp"
+#include "prx/libc/include/General.hpp"
+#include "prx/libc/include/GuestArena.hpp"
+#include "prx/libkernel/File/include/FileFlags.hpp"
+#include <array>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <sys/mman.h>
+#include <unistd.h>
+
+namespace {
+void Check(bool value) {
+    if (!value) std::abort();
+}
+char* memory;
+std::size_t page;
+std::array<unsigned, 2> pins{};
+unsigned begins = 0, ends = 0;
+struct Token { std::array<bool, 2> pages{}; };
+
+void* Begin(std::uintptr_t address, std::size_t bytes) {
+    ++begins;
+    auto* token = new Token;
+    for (unsigned i = 0; i < 2; ++i) {
+        const auto start = reinterpret_cast<std::uintptr_t>(memory + i * page);
+        if (bytes != 0 && address < start + page && address + bytes > start) {
+            token->pages[i] = true;
+            if (pins[i]++ == 0) Check(mprotect(memory + i * page, page, PROT_READ | PROT_WRITE) == 0);
+        }
+    }
+    return token;
+}
+void End(void* value) {
+    ++ends;
+    auto* token = static_cast<Token*>(value);
+    for (unsigned i = 0; i < 2; ++i)
+        if (token->pages[i] && --pins[i] == 0) Check(mprotect(memory + i * page, page, PROT_READ) == 0);
+    delete token;
+}
+}
+
+int main() {
+    page = static_cast<std::size_t>(sysconf(_SC_PAGESIZE));
+    memory = static_cast<char*>(mmap(nullptr, page * 2, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0));
+    Check(memory != MAP_FAILED);
+    std::memset(memory, '?', page * 2);
+    Check(mprotect(memory, page * 2, PROT_READ) == 0);
+    const auto path = std::filesystem::temp_directory_path() / ("anyps5-host-write-" + std::to_string(getpid()));
+    { std::ofstream file(path, std::ios::binary); file << "ABCDEFGH"; Check(bool(file)); }
+    AddPathAlias_nid_no_patch("/host-write-tests", path.parent_path().string().c_str());
+    const auto guest = "/host-write-tests/" + path.filename().string();
+    const int fd = sceKernelOpen(guest.c_str(), SCE_KERNEL_O_RDONLY, 0);
+    Check(fd >= 0);
+    constexpr auto fault = static_cast<std::int32_t>(0x8002000e);
+    Check(sceKernelPread(fd, memory, 4, 0) == fault);
+    Check(memory[0] == '?');
+    GuestArena::GuestArenaSetHostWriteHooks_nid_no_patch(Begin, End);
+    Check(sceKernelRead(fd, memory, 4) == 4);
+    Check(std::memcmp(memory, "ABCD", 4) == 0);
+    Check(sceKernelPread(fd, memory + page - 2, 4, 4) == 4);
+    Check(std::memcmp(memory + page - 2, "EFGH", 4) == 0);
+    std::array<KernelIovec, 2> iov{{{memory + 16, 2}, {memory + page + 16, 2}}};
+    Check(sceKernelPreadv(fd, iov.data(), iov.size(), 0) == 4);
+    Check(std::memcmp(memory + 16, "AB", 2) == 0);
+    Check(std::memcmp(memory + page + 16, "CD", 2) == 0);
+    Check(sceKernelReadv(fd, iov.data(), iov.size()) == 4);
+    Check(std::memcmp(memory + 16, "EF", 2) == 0);
+    Check(std::memcmp(memory + page + 16, "GH", 2) == 0);
+    Check(begins == ends && pins[0] == 0 && pins[1] == 0);
+    Check(GuestArena::GuestArenaBeginHostWrite_nid_postfix(memory, 1));
+    Check(GuestArena::GuestArenaBeginHostWrite_nid_postfix(memory + page, 1));
+    GuestArena::GuestArenaEndHostWrite_nid_postfix(memory, 1);
+    Check(pins[0] == 0 && pins[1] == 1);
+    GuestArena::GuestArenaSetHostWriteHooks_nid_no_patch(nullptr, nullptr);
+    GuestArena::GuestArenaEndHostWrite_nid_postfix(memory + page, 1);
+    Check(begins == ends && pins[1] == 0);
+    Check(sceKernelPread(fd, memory, 4, 0) == fault);
+    Check(sceKernelClose(fd) == 0);
+    Check(munmap(memory, page * 2) == 0);
+    std::filesystem::remove(path);
+    std::puts("Protected scalar/vector reads and host-write hook lifetimes passed");
+}
diff --git a/docs/dev/BUILD.md b/docs/dev/BUILD.md
index b6034dec89..dd938db734 100644
--- a/docs/dev/BUILD.md
