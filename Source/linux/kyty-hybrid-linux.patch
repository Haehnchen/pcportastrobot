+    constexpr uint64_t page_size = 4096;
+    const uint64_t end = vaddr + size;
+    for (uint64_t address = vaddr; address < end;) {
+        const auto watched = m_page_manager.CountWatchedPages(address, 1);
+        if (watched.write != 0 || watched.access != 0)
+            (void)HandleFault(PageFaultAccess::Write, address);
+        const uint64_t next = (address | (page_size - 1)) + 1;
+        if (next <= address) break;
+        address = next;
+    }
+    return true;
+}
