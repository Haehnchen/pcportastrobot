+    if (!GuestRange {vaddr, size}.Valid() || size == 0) return false;
+    m_mutex.Lock();
+    {
+        std::shared_lock lock(m_mapped_ranges_mutex);
+        if (!m_mapped_ranges.Intersects(vaddr, size)) {
+            m_mutex.Unlock();
+            return false;
+        }
