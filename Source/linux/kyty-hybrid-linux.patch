+	if (fg.feature) NVSDK_NGX_VULKAN_ReleaseFeature(fg.feature);
+	if (s.feature) NVSDK_NGX_VULKAN_ReleaseFeature(s.feature);
+	if (fg.params) NVSDK_NGX_VULKAN_DestroyParameters(fg.params);
+	if (s.params) NVSDK_NGX_VULKAN_DestroyParameters(s.params);
+	if (fg.depth_view) graphics.device.destroyImageView(fg.depth_view);
+	if (fg.motion_view) graphics.device.destroyImageView(fg.motion_view);
+	if (fg.depth.image) graphics.DeleteImage(fg.depth);
+	if (fg.motion.image) graphics.DeleteImage(fg.motion);
+	fg.feature    = nullptr;
+	fg.params     = nullptr;
+	fg.depth_view = fg.motion_view = nullptr;
+	s.feature                      = nullptr;
+	s.params                       = nullptr;
+	if (s.init_tried) NVSDK_NGX_VULKAN_Shutdown1(static_cast<VkDevice>(graphics.device));
+    s.init_tried = s.ready = false;
+    s.last_frame = 0;
+    fg.camera = fg.inputs = fg.previous_valid = fg.failed = false;
+#endif
+}
