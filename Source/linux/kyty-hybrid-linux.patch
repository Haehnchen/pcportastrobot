+
+void BridgeSignal(int signal, siginfo_t* details, void* context) {
+    auto* uc = static_cast<ucontext_t*>(context);
+    Common::HostException::ExceptionInfo info {};
+    info.type = Common::HostException::ExceptionType::AccessViolation;
+    const auto error = uc->uc_mcontext.gregs[REG_ERR];
+    using Access = Common::HostException::AccessViolationType;
+    info.access_violation_type = (error & 16) ? Access::Execute : (error & 2) ? Access::Write : Access::Read;
+    info.access_violation_vaddr = reinterpret_cast<uint64_t>(details->si_addr);
+    info.exception_address = uc->uc_mcontext.gregs[REG_RIP];
+    info.native_context = context;
+    if (BridgeGuestAccessFault(info)) return;
+    const auto& previous = signal == SIGSEGV ? g_previous_segv : g_previous_bus;
+    if (previous.sa_handler == SIG_DFL || previous.sa_handler == SIG_IGN) {
+        sigaction(signal, &previous, nullptr);
+        return;
+    }
+    if (previous.sa_flags & SA_SIGINFO) previous.sa_sigaction(signal, details, context);
+    else previous.sa_handler(signal);
+}
+
+bool InstallBridgeFaultHandler() {
+    struct sigaction action {};
+    action.sa_sigaction = BridgeSignal;
+    action.sa_flags = SA_SIGINFO | SA_ONSTACK | SA_RESTART;
+    sigemptyset(&action.sa_mask);
+    if (sigaction(SIGSEGV, &action, &g_previous_segv) != 0) return false;
+    if (sigaction(SIGBUS, &action, &g_previous_bus) != 0) {
+        sigaction(SIGSEGV, &g_previous_segv, nullptr);
+        return false;
+    }
+    return true;
+}
+#else
+bool InstallBridgeFaultHandler() {
+    return Common::HostException::InstallFirstAccessHandler(BridgeGuestAccessFault);
+}
+#endif
