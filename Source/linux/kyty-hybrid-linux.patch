+++ b/src/graphics/host_gpu/renderer/nativeDlssg.inc
@@ -0,0 +1,159 @@
+#if KYTY_NGX && !defined(_WIN32)
+using NativeMatrix = std::array<float, 16>;
+
+NativeMatrix NativeMultiply(const NativeMatrix& a, const NativeMatrix& b) {
+	NativeMatrix result {};
+	for (unsigned i = 0; i < 4; ++i)
+		for (unsigned j = 0; j < 4; ++j)
+			for (unsigned k = 0; k < 4; ++k)
+				result[i * 4 + j] += a[i * 4 + k] * b[k * 4 + j];
+	return result;
+}
+
+bool NativeInverse(const NativeMatrix& input, NativeMatrix& result) {
+	double a[4][8] {};
+	for (unsigned i = 0; i < 4; ++i) {
+		for (unsigned j = 0; j < 4; ++j)
+			a[i][j] = input[i * 4 + j];
+		a[i][i + 4] = 1;
+	}
+	for (unsigned i = 0; i < 4; ++i) {
+		unsigned pivot = i;
+		for (unsigned j = i + 1; j < 4; ++j)
+			if (std::fabs(a[j][i]) > std::fabs(a[pivot][i])) pivot = j;
+		if (std::fabs(a[pivot][i]) < 1e-12) return false;
+		for (unsigned k = 0; k < 8; ++k)
+			std::swap(a[i][k], a[pivot][k]);
+		const double scale = a[i][i];
+		for (double& v: a[i])
+			v /= scale;
+		for (unsigned j = 0; j < 4; ++j) {
+			if (j == i) continue;
+			const double factor = a[j][i];
+			for (unsigned k = 0; k < 8; ++k)
+				a[j][k] -= factor * a[i][k];
+		}
+	}
+	for (unsigned i = 0; i < 4; ++i)
+		for (unsigned j = 0; j < 4; ++j)
+			result[i * 4 + j] = float(a[i][j + 4]);
+	return true;
+}
+
+struct NativeFgState {
+	VulkanImage          depth, motion;
+	vk::ImageView        depth_view {}, motion_view {};
+	NVSDK_NGX_Parameter* params  = nullptr;
+	NVSDK_NGX_Handle*    feature = nullptr;
+	NativeMatrix         projection {}, view {}, previous {};
+	bool                 camera = false, inputs = false, previous_valid = false, failed = false;
+	uint32_t             width = 0, height = 0, frame = 0, previous_frame = 0;
+	vk::Format           format = vk::Format::eUndefined;
+	float                jitter[2] {};
+	uint64_t             evaluations = 0;
+	uint32_t             max_frames = 1, generated_frames = 1, lower_windows = 0, window_frames = 0;
+	bool                 capability_checked = false;
+	std::chrono::steady_clock::time_point window_start {};
+};
+
+NativeFgState& NativeFg() {
+	static NativeFgState state;
+	return state;
+}
+
+void NativeTransit(VulkanImage& image, vk::CommandBuffer cmd, vk::ImageAspectFlags aspect,
+                   vk::ImageLayout layout, vk::AccessFlags2 access) {
+	vk::ImageMemoryBarrier2 barrier {};
+	barrier.srcStageMask        = image.state.pl_stage;
+	barrier.srcAccessMask       = image.state.access_mask;
+	barrier.dstStageMask        = vk::PipelineStageFlagBits2::eAllCommands;
+	barrier.dstAccessMask       = access;
+	barrier.oldLayout           = image.state.layout;
+	barrier.newLayout           = layout;
+	barrier.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+	barrier.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+	barrier.image               = image.image;
+	if ((aspect & vk::ImageAspectFlagBits::eDepth) &&
+	    (image.format == vk::Format::eD16UnormS8Uint ||
+	     image.format == vk::Format::eD24UnormS8Uint ||
+	     image.format == vk::Format::eD32SfloatS8Uint))
+		aspect |= vk::ImageAspectFlagBits::eStencil;
+	barrier.subresourceRange = {aspect, 0, 1, 0, 1};
+	vk::DependencyInfo dependency {};
+	dependency.imageMemoryBarrierCount = 1;
+	dependency.pImageMemoryBarriers    = &barrier;
+	cmd.pipelineBarrier2(dependency);
+	image.state = {barrier.dstStageMask, access, layout};
+	image.subresource_states.clear();
+}
+
+bool NativeSnapshot(RenderContext& context, CommandBuffer& buffer, Image& source,
+                    VulkanImage& target, vk::ImageView& view, vk::ImageAspectFlags aspect) {
+	auto& graphics = context.GetGraphics();
+	if (!target.image || !view || target.extent.width != source.info.extent.width ||
+	    target.extent.height != source.info.extent.height ||
+	    target.format != source.backing.format) {
+		context.GetCommandScheduler().FlushAndWait();
+		if (view) graphics.device.destroyImageView(view);
+		view = nullptr;
+		if (target.image) graphics.DeleteImage(target);
+		vk::ImageCreateInfo create {};
+		create.imageType = vk::ImageType::e2D;
+		create.format    = source.backing.format;
+		create.extent    = {source.info.extent.width, source.info.extent.height, 1};
+		create.mipLevels = create.arrayLayers = 1;
+		create.samples                        = vk::SampleCountFlagBits::e1;
+		create.tiling                         = vk::ImageTiling::eOptimal;
+		create.usage = vk::ImageUsageFlagBits::eSampled | vk::ImageUsageFlagBits::eTransferDst;
+		if (!graphics.CreateImage(create, target)) return false;
+		vk::ImageViewCreateInfo view_info {};
+		view_info.image            = target.image;
+		view_info.viewType         = vk::ImageViewType::e2D;
+		view_info.format           = target.format;
+		view_info.subresourceRange = {aspect, 0, 1, 0, 1};
+		if (graphics.device.createImageView(&view_info, nullptr, &view) != vk::Result::eSuccess)
+			return false;
+	}
+	buffer.EndRendering();
+	const auto cmd = buffer.Handle();
+	source.Transit(vk::ImageLayout::eTransferSrcOptimal, vk::AccessFlagBits2::eTransferRead, {},
+	               cmd);
+	NativeTransit(target, cmd, aspect, vk::ImageLayout::eTransferDstOptimal,
+	              vk::AccessFlagBits2::eTransferWrite);
+	vk::ImageCopy copy {};
+	copy.srcSubresource = copy.dstSubresource = {aspect, 0, 0, 1};
+	copy.extent                               = target.extent;
+	cmd.copyImage(source.backing.image, vk::ImageLayout::eTransferSrcOptimal, target.image,
+	              vk::ImageLayout::eTransferDstOptimal, copy);
+	NativeTransit(target, cmd, aspect, vk::ImageLayout::eShaderReadOnlyOptimal,
+	              vk::AccessFlagBits2::eShaderSampledRead);
+	return true;
+}
+
+void NativeSetCamera(const float* camera) {
+	if (!Dlss::NativeFrameGenerationRequested()) return;
+	auto& s = NativeFg();
+	if (s.camera) return;
+	std::memcpy(s.projection.data(), camera, 64);
+	std::memcpy(s.view.data(), camera + 16, 64);
+	s.projection[8] = s.projection[9] = 0;
+	s.camera                          = true;
+}
+
+void NativeCapture(RenderContext& context, CommandBuffer& buffer, Image& depth, Image& motion,
+                   const float* jitter, uint32_t frame) {
+	if (!Dlss::NativeFrameGenerationRequested()) return;
+	auto& s  = NativeFg();
+	s.inputs = !s.failed && s.camera &&
+	           NativeSnapshot(context, buffer, depth, s.depth, s.depth_view,
+	                          vk::ImageAspectFlagBits::eDepth) &&
+	           NativeSnapshot(context, buffer, motion, s.motion, s.motion_view,
+	                          vk::ImageAspectFlagBits::eColor);
+	s.jitter[0] = jitter[0];
+	s.jitter[1] = jitter[1];
+	s.frame     = frame;
+}
+#else
+void NativeSetCamera(const float*) {}
+void NativeCapture(RenderContext&, CommandBuffer&, Image&, Image&, const float*, uint32_t) {}
+#endif
