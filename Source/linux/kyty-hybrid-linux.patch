+uint32_t NativeFramesToGenerate() {
+#if KYTY_NGX && !defined(_WIN32)
+    if (!NativeFrameGenerationRequested()) return 0;
+    auto& s = NativeFg();
+    if (!s.capability_checked && Get().params) {
+        unsigned maximum = 1;
+        NVSDK_NGX_Parameter_GetUI(Get().params, NVSDK_NGX_DLSSG_Parameter_MultiFrameCountMax, &maximum);
+        s.max_frames = std::clamp(maximum, 1u, 3u);
+        s.capability_checked = true;
+        std::printf("DLSS-G native: runtime supports up to %ux\n", s.max_frames + 1);
+    }
+    const auto setting = [](const char* name, int fallback, int low, int high) {
+        const char* value = std::getenv(name);
+        return value ? std::clamp(std::atoi(value), low, high) : fallback;
+    };
+    const auto maximum = std::min(s.max_frames, unsigned(setting("ASTROHYBRID_DLSSG_MAX_FRAMES", 3, 1, 3)));
+    const auto target = setting("ASTROHYBRID_DLSSG_TARGET", 0, 0, 400);
+    if (target == 0) {
+        s.generated_frames = std::min(s.max_frames, unsigned(setting("ASTROHYBRID_DLSSG_FRAMES", 1, 1, 3)));
+    } else {
+        const auto now = std::chrono::steady_clock::now();
+        if (s.window_start.time_since_epoch().count() == 0) s.window_start = now;
+        else ++s.window_frames;
+        const double elapsed = std::chrono::duration<double>(now - s.window_start).count();
+        if (elapsed >= 0.5) {
+            const double fps = s.window_frames / elapsed;
+            const auto wanted = unsigned(std::clamp(std::ceil(target / std::max(fps, 1.0) - 0.02) - 1.0,
+                                                    1.0, double(maximum)));
+            if (wanted > s.generated_frames || (wanted < s.generated_frames && ++s.lower_windows >= 4)) {
+                s.generated_frames = wanted;
+                s.lower_windows = 0;
+            } else if (wanted == s.generated_frames) {
+                s.lower_windows = 0;
+            }
+            s.window_frames = 0;
+            s.window_start = now;
+        }
+        s.generated_frames = std::clamp(s.generated_frames, 1u, maximum);
+    }
+    static uint32_t reported = 0;
+    if (reported != s.generated_frames) {
+        reported = s.generated_frames;
+        std::printf("DLSS-G native: selected %ux (%u generated frames)\n", reported + 1, reported);
+    }
+    return s.generated_frames;
+#else
+    return 0;
+#endif
